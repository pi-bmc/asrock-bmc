--- a/test/redfish-core/include/utils/json_utils_test.cpp
+++ b/test/redfish-core/include/utils/json_utils_test.cpp
@@ -255,6 +255,51 @@ TEST(ReadJson, ExtraElement)
     EXPECT_EQ(str, "hello");
 }
 
+// What a client sends when it writes back an object it read, as gofish's
+// ComputerSystem.SetBoot does with Boot.
+TEST(ReadJson, PropertyAnnotationsIgnored)
+{
+    crow::Response res;
+    nlohmann::json jsonRequest = {
+        {"Boot",
+         {{"BootSourceOverrideTarget", "Pxe"},
+          {"BootSourceOverrideTarget@Redfish.AllowableValues",
+           {"None", "Pxe"}}}},
+        {"Members@odata.count", 2}};
+
+    std::optional<std::string> target;
+    ASSERT_TRUE(
+        readJson(jsonRequest, res, "Boot/BootSourceOverrideTarget", target));
+    EXPECT_EQ(res.result(), boost::beast::http::status::ok);
+    EXPECT_THAT(res.jsonValue, IsEmpty());
+    EXPECT_EQ(target, "Pxe");
+}
+
+TEST(ReadJson, NamedPropertyAnnotationStillUnpacked)
+{
+    crow::Response res;
+    nlohmann::json jsonRequest = {{"Members@odata.count", 2}};
+
+    std::optional<int> count;
+    ASSERT_TRUE(readJson(jsonRequest, res, "Members@odata.count", count));
+    EXPECT_EQ(res.result(), boost::beast::http::status::ok);
+    EXPECT_EQ(count, 2);
+}
+
+// Object-level annotations change what a request means; they stay unknown
+// unless a handler asks for them.
+TEST(ReadJson, ObjectAnnotationStillUnknown)
+{
+    crow::Response res;
+    nlohmann::json jsonRequest = {
+        {"integer", 1}, {"@Redfish.SettingsApplyTime", nlohmann::json::object()}};
+
+    std::optional<int> integer;
+    EXPECT_FALSE(readJson(jsonRequest, res, "integer", integer));
+    EXPECT_EQ(res.result(), boost::beast::http::status::bad_request);
+    EXPECT_FALSE(res.jsonValue.empty());
+}
