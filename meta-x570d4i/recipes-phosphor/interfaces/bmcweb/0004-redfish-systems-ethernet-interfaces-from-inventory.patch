+#include "systems_ethernet.hpp"
 #include "systems_logservices_dbus_eventlog.hpp"
 #include "systems_logservices_hostlogger.hpp"
 #include "systems_logservices_journal_eventlog.hpp"
@@ -202,6 +203,8 @@
     requestRoutesMemory(app);
 
     requestRoutesSystems(app);
+    requestRoutesSystemsEthernetInterfaceCollection(app);
+    requestRoutesSystemsEthernetInterface(app);
 
     requestRoutesBiosService(app);
     requestRoutesBiosReset(app);
--- a/redfish-core/lib/systems.hpp
+++ b/redfish-core/lib/systems.hpp
@@ -3096,6 +3096,9 @@
         asyncResp->res.jsonValue["FabricAdapters"]["@odata.id"] =
             boost::urls::format("/redfish/v1/Systems/{}/FabricAdapters",
                                 systemName);
+        asyncResp->res.jsonValue["EthernetInterfaces"]["@odata.id"] =
+            boost::urls::format("/redfish/v1/Systems/{}/EthernetInterfaces",
