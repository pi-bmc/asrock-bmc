+inline void handleBiosServiceWrite(
+    crow::App& app, const crow::Request& req,
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    const std::string& systemName)
+{
+    if (!redfish::setUpRedfishRoute(app, req, asyncResp))
+    {
+        return;
+    }
+    if (systemName != BMCWEB_REDFISH_SYSTEM_URI_NAME &&
+        !ami_hi::isSystemAlias(systemName))
+    {
+        messages::resourceNotFound(asyncResp->res, "ComputerSystem",
+                                   systemName);
+        return;
+    }
+    // POST is the AMI BIOS publishing its live configuration, which doubles as
+    // the acknowledgement that it applied whatever was staged; PATCH is an
+    // incremental correction and must not clear the pending set.
+    ami_hi::handleBiosWrite(
+        req, asyncResp, req.method() == boost::beast::http::verb::post);
+}
+
 inline void requestRoutesBiosService(App& app)
 {
+    // No .privileges(): the AMI Redfish Host Interface is unauthenticated by
+    // design (stock MegaRAC grants AuthNoneRoleId=Administrator on the
+    // host-interface address). Containment lives in the authentication layer --
+    // http_connection.hpp only skips the 401 for connections accepted ON
+    // 169.254.0.17 -- so an unauthenticated request from the management network
+    // never reaches this handler. The practical difference for LAN clients is
+    // that reading /Bios now needs any authenticated session rather than the
+    // Login privilege specifically.
     BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Bios/")
-        .privileges(redfish::privileges::getBios)
         .methods(boost::beast::http::verb::get)(
             std::bind_front(handleBiosServiceGet, std::ref(app)));
+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Bios/")
+        .methods(boost::beast::http::verb::post,
+                 boost::beast::http::verb::patch)(
+            std::bind_front(handleBiosServiceWrite, std::ref(app)));
 }
 
