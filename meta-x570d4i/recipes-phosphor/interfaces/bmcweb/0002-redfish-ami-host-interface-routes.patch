index 0e799af164..d06310410f 100644
--- a/http/http_request.hpp
+++ b/http/http_request.hpp
@@ -38,6 +38,12 @@ struct Request
   public:
     boost::asio::ip::address ipAddress;
 
+    // Address this connection was accepted ON (not the peer). The AMI Redfish
+    // Host Interface is authenticated purely by which local address it arrived
+    // on, mirroring stock MegaRAC's X-Server-Addr check, so this must be
