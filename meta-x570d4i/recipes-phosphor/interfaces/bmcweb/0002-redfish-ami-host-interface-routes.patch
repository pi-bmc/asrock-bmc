+// ---------------------------------------------------------------------------
+// Route registration.
+//
+// NOTE the deliberate absence of .privileges(): routing/baserule.hpp treats an
+// empty privilege set as "no privileges required", and the authentication layer
+// only lets an unauthenticated request through when it arrived on the
+// host-interface address. See the security note at the top of this file.
+// ---------------------------------------------------------------------------
+inline void requestRoutesAmiHostInterface(App& app)
+{
+    using boost::beast::http::verb;
+
+    // NOTE: the /Bios routes themselves are NOT here. bmcweb's trie tries the
+    // <str> parameter branch before static siblings (findHelper in
+    // http/routing/trie.hpp), so a static /Systems/Self/Bios/ route can never
+    // win against upstream's /Systems/<str>/Bios/. Those methods are merged
+    // into upstream's rule in bios.hpp instead. Everything below is a path
+    // upstream does not claim, where the static fallback does apply.
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Bios/SD/")
+        .methods(verb::get)(
+            [](const crow::Request&,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string&) { ami_hi::handleSettingsGet(asyncResp); });
+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Bios/SD/")
+        .methods(verb::delete_)(
+            [](const crow::Request&,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string&) { ami_hi::handleSettingsDelete(asyncResp); });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/bios/defaultSD/")
+        .methods(verb::get, verb::post, verb::put, verb::delete_)(
+            [](const crow::Request& req,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp) {
+                ami_hi::handleFileResource(req, asyncResp, "defaults",
+                                           "defaultSD.json");
+            });
+
+    BMCWEB_ROUTE(
+        app, "/redfish/v1/Systems/Self/Bios/Actions/Bios.ChangePassword/")
+        .methods(verb::get, verb::delete_)(
+            [](const crow::Request& req,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp) {
+                ami_hi::handleFileResource(req, asyncResp, "static",
+                                           "ChangePassword.json");
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Registries/<str>/")
+        .methods(verb::post, verb::put)(
+            [](const crow::Request& req,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string& name) {
+                ami_hi::handleRegistryPost(req, asyncResp, name);
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/DynamicExtension/RedfishExtensions/")
+        .methods(verb::get)(
+            [](const crow::Request&,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp) {
+                asyncResp->res.jsonValue["@odata.id"] =
+                    "/redfish/v1/DynamicExtension/RedfishExtensions";
+                asyncResp->res.jsonValue["Name"] = "Redfish Extensions";
+                asyncResp->res.jsonValue["Members"] = nlohmann::json::array();
+                asyncResp->res.jsonValue["Members@odata.count"] = 0;
+            });
+    BMCWEB_ROUTE(app,
+                 "/redfish/v1/DynamicExtension/RedfishExtensions/PostStatus/")
+        .methods(verb::get, verb::post)(
+            [](crow::Request& req,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp) {
+                ami_hi::handleUpload(req, asyncResp, "dynext");
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/BiosStaticFiles/")
+        .methods(verb::post)(
+            [](crow::Request& req,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp) {
+                ami_hi::handleUpload(req, asyncResp, "biosstaticfile");
+            });
+    BMCWEB_ROUTE(app, "/redfish/v1/BiosStaticFiles/PostStatus/")
+        .methods(verb::get, verb::post)(
+            [](crow::Request& req,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp) {
+                ami_hi::handleUpload(req, asyncResp, "biosstaticstatus");
+            });
+    BMCWEB_ROUTE(app, "/ami/static-file/")
+        .methods(verb::post)(
+            [](crow::Request& req,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp) {
+                ami_hi::handleUpload(req, asyncResp, "amistaticfile");
+            });
+}
+
+} // namespace redfish
