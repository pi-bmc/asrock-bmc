+/*
+ * Boot settings cache.
+ *
+ * The BIOS reads these properties over KCS during POST and has a hard time
+ * budget for every reply: on this board OpenOobPkg's KCS transport (which
+ * also carries AMI's own IPMI traffic) waits roughly one to two seconds, and
+ * a reply that misses that window wedges the interface for the rest of POST.
+ * Answering Get System Boot Options parameter 5 used to cost twelve
+ * sequential D-Bus round trips -- an ObjectMapper GetObject plus a Settings
+ * Get for each of six properties. That is about 165 ms on an idle BMC, but it
+ * was measured at 5.25 s at the moment the BIOS asks, because p2a-inventory-
+ * monitor republishes the whole PCIe/NVMe inventory then and every one of
+ * those calls queues behind the mapper. The BIOS gave up on the reply, the
+ * interface wedged, and the boot override was silently ignored.
+ *
+ * The values live in xyz.openbmc_project.Settings and only change when
+ * somebody sets them, which that daemon announces with PropertiesChanged. So
+ * keep a copy: resolve each service once, fill each value on first read, and
+ * let a PropertiesChanged match on the two objects keep the copy current.
+ * Reads are then answered without touching D-Bus at all, and writes that
+ * would not change anything (most of the BIOS's all-zero clear) are skipped.
+ *
+ * Every property change bumps a per-property generation. A read or write that
+ * raced a change -- its reply processed after the signal -- does not store its
+ * now-stale result. A Settings restart drops everything.
+ */
+namespace boot_settings_cache
+{
+
+std::map<std::string, std::string> services;
+std::map<std::string, ipmi::Value> values;
+std::map<std::string, uint64_t> generations;
+std::map<std::string, std::unique_ptr<sdbusplus::bus::match_t>> matches;
+
+static std::string serviceKey(const std::string& path, const std::string& intf)
+{
+    return path + '\n' + intf;
+}
+
+static std::string valueKey(const std::string& path, const std::string& intf,
+                            const std::string& prop)
+{
+    return path + '\n' + intf + '\n' + prop;
+}
+
+static void forget(const std::string& prefix)
+{
+    std::erase_if(services, [&prefix](const auto& kv) {
+        return kv.first.starts_with(prefix);
+    });
+    std::erase_if(values, [&prefix](const auto& kv) {
+        return kv.first.starts_with(prefix);
+    });
+}
+
+static void watch(const std::string& name, const std::string& rule,
+                  std::function<void(sdbusplus::message_t&)> callback)
+{
+    if (matches.contains(name))
+    {
+        return;
+    }
+    matches.emplace(name, std::make_unique<sdbusplus::bus::match_t>(
+                              *getSdBus(), rule.c_str(), std::move(callback)));
+}
+
+static void watchPath(const std::string& path)
+{
+    watch("props:" + path,
+          "type='signal',interface='org.freedesktop.DBus.Properties',"
+          "member='PropertiesChanged',path='" +
+              path + "'",
+          [path](sdbusplus::message_t& msg) {
+              std::string intf;
+              std::map<std::string, ipmi::Value> changed;
+              try
+              {
+                  msg.read(intf, changed);
+              }
+              catch (const std::exception&)
+              {
+                  // Undecodable: never risk keeping a stale copy.
+                  forget(path + '\n');
+                  return;
+              }
+              for (const auto& [prop, value] : changed)
+              {
+                  const auto key = valueKey(path, intf, prop);
+                  ++generations[key];
+                  if (auto it = values.find(key); it != values.end())
+                  {
+                      it->second = value;
+                  }
+              }
+          });
+}
+
+static void watchOwner(const std::string& service)
+{
+    watch("owner:" + service,
+          sdbusplus::bus::match::rules::nameOwnerChanged(service),
+          [](sdbusplus::message_t&) {
+              // The settings daemon restarted or went away.
+              services.clear();
+              values.clear();
+          });
+}
+
+static boost::system::error_code getService(ipmi::Context::ptr& ctx,
+                                            const std::string& intf,
+                                            const std::string& path,
+                                            std::string& service)
+{
+    const auto key = serviceKey(path, intf);
+    if (auto it = services.find(key); it != services.end())
+    {
+        service = it->second;
+        return {};
+    }
+    boost::system::error_code ec = ipmi::getService(ctx, intf, path, service);
+    if (!ec)
+    {
+        // Arm the matches before any value is cached, so no change can slip
+        // between the first read and the subscription.
+        watchPath(path);
+        watchOwner(service);
+        services.insert_or_assign(key, service);
+    }
+    return ec;
+}
+
+template <typename T>
+static boost::system::error_code getProperty(
+    ipmi::Context::ptr& ctx, const std::string& service,
+    const std::string& path, const std::string& intf, const std::string& prop,
+    T& value)
+{
+    const auto key = valueKey(path, intf, prop);
+    if (auto it = values.find(key); it != values.end())
+    {
+        if (const auto* cached = std::get_if<T>(&it->second))
+        {
+            value = *cached;
+            return {};
+        }
+    }
+    const uint64_t before = generations[key];
+    boost::system::error_code ec =
+        ipmi::getDbusProperty(ctx, service, path, intf, prop, value);
+    if (ec)
+    {
+        forget(serviceKey(path, intf));
+    }
+    else if (generations[key] == before)
+    {
+        values.insert_or_assign(key, ipmi::Value(value));
+    }
+    return ec;
+}
+
+static boost::system::error_code setProperty(
+    ipmi::Context::ptr& ctx, const std::string& service,
+    const std::string& path, const std::string& intf, const std::string& prop,
+    const ipmi::Value& value)
+{
+    const auto key = valueKey(path, intf, prop);
+    if (auto it = values.find(key); it != values.end() && it->second == value)
+    {
+        return {};
+    }
+    const uint64_t before = generations[key];
+    boost::system::error_code ec =
+        ipmi::setDbusProperty(ctx, service, path, intf, prop, value);
+    if (ec)
+    {
+        forget(serviceKey(path, intf));
+    }
+    else if (generations[key] == before)
+    {
+        values.insert_or_assign(key, value);
+    }
+    return ec;
+}
+
+} // namespace boot_settings_cache
