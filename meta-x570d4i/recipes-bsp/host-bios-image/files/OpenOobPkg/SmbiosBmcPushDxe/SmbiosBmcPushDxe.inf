## @file
#  SmbiosBmcPushDxe — push the host SMBIOS table to the BMC at ReadyToBoot via
#  the standard OpenBMC phosphor-ipmi-blobs protocol (blob ID "/smbios") over the
#  host KCS interface (LPC I/O 0xCA2/0xCA3).
#
#  This module is injected by REPLACING the PE32 and DEPEX sections of the AMI
#  SendInfoBmcIpmiDxe FFS slot (FILE_GUID 9DF02DFD-8CF7-4FC7-B8AE-CBD9560A3F24),
#  so the FFS keeps AMI's GUID and UI name and the FILE_GUID below is not what
#  ends up in the flash image.
#
#  This module does SMBIOS and nothing else. The KCS transport and the POST-code
#  helper come from ../Library/IpmiKcsLib rather than being defined here, so the
#  interface state machine has exactly one implementation.
#
#  Copyright (c) 2024, ASRockRack X570D4I-2T OpenBMC port.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SmbiosBmcPushDxe
  FILE_GUID                      = 4a2b7c8d-1234-5678-abcd-ef0123456789
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SmbiosBmcPushEntry

[Sources]
  SmbiosBmcPushDxe.c

[Packages]
  MdePkg/MdePkg.dec
  OpenOobPkg/OpenOobPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  IoLib
  DebugLib
  IpmiKcsLib
  OobTelemetryLib

[Protocols]
  gEfiSmbiosProtocolGuid              ## CONSUMES

[Guids]
  gEfiEventReadyToBootGuid            ## CONSUMES  ## Event
  gEfiEndOfDxeEventGroupGuid          ## CONSUMES  ## Event
  gEfiSmbiosTableGuid                 ## SOMETIMES_CONSUMES  ## SystemTable
  gEfiSmbios3TableGuid                ## SOMETIMES_CONSUMES  ## SystemTable

[Depex]
  TRUE
