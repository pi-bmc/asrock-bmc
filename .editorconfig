# EditorConfig: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4
charset = utf-8
insert_final_newline = true
end_of_line = lf
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2

[*.{c,h,cpp,cc,hh,ld,lds}]
indent_style = tab
indent_size = 8
tab_width = 8
charset = utf-8
insert_final_newline = true
end_of_line = lf
trim_trailing_whitespace = true

[*.sh]
indent_style = space
indent_size = 2
