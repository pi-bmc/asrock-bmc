## @file
#  The driver injected into the AMI SendInfoBmcIpmiDxe FFS slot. Two halves
#  share one KCS transport (LPC I/O 0xCA2/0xCA3):
#
#    SmbiosBmcPushDxe.c  push the host SMBIOS table to the BMC at ReadyToBoot
#                        via phosphor-ipmi-blobs (blob ID "/smbios")
#    BiosCfgOobDxe.c     host side of the OpenBMC BIOS-config OOB command set
#                        (NetFn 0x30, cmds 0xD3-0xD6): publish the knob schema
#                        and the LIVE varstore values, and apply settings the
#                        BMC has staged from Redfish
#
#  Both are built into one PE32 because the ROM patch replaces exactly one FFS
#  file; adding a second one would disturb the AMI dispatch order.
#
#  Copyright (c) 2024, ASRockRack X570D4I-2T OpenBMC port.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SmbiosBmcPushDxe
  FILE_GUID                      = 4a2b7c8d-1234-5678-abcd-ef0123456789
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SmbiosBmcPushEntry

[Sources]
  SmbiosBmcPushDxe.c
  BiosCfgOobDxe.c
  HostBmcKcs.h
  BiosCfgOobVarstores.h
  BiosCfgOobSchema.h

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  IoLib
  DebugLib

[Protocols]
  gEfiSmbiosProtocolGuid              ## CONSUMES

[Guids]
  gEfiEventReadyToBootGuid            ## CONSUMES  ## Event
  gEfiEndOfDxeEventGroupGuid          ## CONSUMES  ## Event
  gEfiSmbiosTableGuid                 ## SOMETIMES_CONSUMES  ## SystemTable
  gEfiSmbios3TableGuid                ## SOMETIMES_CONSUMES  ## SystemTable

[Depex]
  TRUE
