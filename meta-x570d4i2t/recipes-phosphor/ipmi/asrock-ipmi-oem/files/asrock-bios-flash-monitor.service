[Unit]
Description=ASRock BIOS attribute sync from host BIOS flash
Documentation=man:asrock-bios-nvram(1)
# Needs D-Bus (power state, BIOSConfig.Manager) and the BIOS-config state
# directory that the ipmid provider populates with the knob schema XML.
After=dbus.service phosphor-ipmi-host.service
Wants=dbus.service

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStart=/usr/libexec/asrock-bios-flash-monitor.sh

[Install]
WantedBy=multi-user.target
